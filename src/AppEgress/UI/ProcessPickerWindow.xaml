<Window x:Class="AppEgress.UI.ProcessPickerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AppEgress.Localization"
        Title="{l:Tr RunningPrograms}"
        Width="760" Height="600" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.Text}" FontSize="14"
        Foreground="{DynamicResource Text.Primary}"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="ProcessItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="Fallback" Style="{StaticResource Icon}" Text="&#xE737;" FontSize="18" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Text.Caption}" Margin="10,1,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    </StackPanel>
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.CaptionTertiary}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding PidText}" Style="{StaticResource Text.Caption}" Margin="14,0,4,0"
                           VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Fallback" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Height="32" />

        <StackPanel Grid.Row="1" Margin="24,0,24,12">
            <TextBlock Text="{l:Tr RunningPrograms}" Style="{StaticResource Text.Subtitle}" />
            <Grid Margin="0,14,0,0">
                <TextBox x:Name="SearchBox" Tag="{l:Tr SearchPlaceholder}" Padding="36,6,10,6"
                         TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Margin="12,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource Text.Secondary}" IsHitTestVisible="False" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="24,0,24,16" Padding="4">
            <Grid>
                <ListBox x:Name="List" Style="{StaticResource ListBox.Plain}" ItemContainerStyle="{StaticResource ListItem.Fluent}"
                         ItemTemplate="{StaticResource ProcessItem}" MouseDoubleClick="OnDoubleClick"
                         VirtualizingPanel.IsVirtualizing="True" />
                <TextBlock x:Name="LoadingText" Text="{l:Tr LoadingProcesses}" Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource Dialog.FooterBg}" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Divider}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Btn.Subtle}" Click="OnRefresh">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" />
                        <TextBlock Text="{l:Tr Refresh}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Content="{l:Tr Select}" Style="{StaticResource Btn.Accent}" IsDefault="True" Click="OnSelect" />
                <Button Grid.Column="4" Content="{l:Tr Cancel}" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
