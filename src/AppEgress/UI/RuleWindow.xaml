<Window x:Class="AppEgress.UI.RuleWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AppEgress.Localization"
        Title="{l:Tr RuleNewTitle}"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.Text}" FontSize="14"
        Foreground="{DynamicResource Text.Primary}"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="AdapterOption">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,14,0" VerticalAlignment="Center"
                        Background="{DynamicResource Subtle.BgHover}">
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="17" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Accent.Text}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Caption}" Margin="8,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUsable}" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Height="32" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,4,28,22">
            <TextBlock x:Name="Heading" Text="{l:Tr RuleNewTitle}" Style="{StaticResource Text.Subtitle}" />
            <TextBlock x:Name="IntroText" Text="{l:Tr RuleIntro}"
                       Style="{StaticResource Text.Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />

            <!-- Программа -->
            <TextBlock Text="{l:Tr ProgramSection}" Style="{StaticResource Text.Section}" Margin="2,22,0,8" />
            <Border Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="8" Margin="0,0,14,0" Background="{DynamicResource Subtle.BgHover}">
                        <Grid>
                            <Image x:Name="ProgramIcon" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="ProgramGlyph" Style="{StaticResource Icon}" Text="&#xE737;" FontSize="18"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ProgramName" Text="{l:Tr ProgramNotSelected}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProgramDetail" Text="{l:Tr ProgramPickHint}"
                                   Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Tag="{l:Tr PathPlaceholder}" TextChanged="OnPathChanged" />
                <Button Grid.Column="1" Margin="8,0,0,0" Click="OnPickRunning" ToolTip="{l:Tr PickRunningTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7C4;" FontSize="14" />
                        <TextBlock Text="{l:Tr Running}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Margin="8,0,0,0" Click="OnBrowse" ToolTip="{l:Tr BrowseTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="14" />
                        <TextBlock Text="{l:Tr Browse}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
            <CheckBox x:Name="ByName" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                      Checked="OnByNameChanged" Unchecked="OnByNameChanged">
                <TextBlock Text="{l:Tr ByNameToggle}" FontSize="13" />
            </CheckBox>

            <!-- Адаптер -->
            <TextBlock Text="{l:Tr RuleModeSection}" Style="{StaticResource Text.Section}" Margin="2,24,0,8" />
            <Border CornerRadius="6" Padding="3" Background="{DynamicResource Subtle.BgHover}">
            <UniformGrid Columns="2">
                <RadioButton x:Name="RouteMode" Content="{l:Tr RuleModeRoute}" GroupName="RuleMode"
                             Style="{StaticResource Segment}" Margin="0,0,4,0" Checked="OnModeChanged" />
                <RadioButton x:Name="MonitorMode" Content="{l:Tr RuleModeMonitor}" GroupName="RuleMode"
                             Style="{StaticResource Segment}" Margin="4,0,0,0" Checked="OnModeChanged" />
            </UniformGrid>
            </Border>
            <Border x:Name="MonitorInfo" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{l:Tr MonitorModeTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Tr MonitorModeDesc}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <StackPanel x:Name="RoutingOptions">
            <TextBlock Text="{l:Tr SendVia}" Style="{StaticResource Text.Section}" Margin="2,24,0,8" />
            <ListBox x:Name="AdapterList" Style="{StaticResource ListBox.Plain}" ItemContainerStyle="{StaticResource ListItem.Card}"
                     ItemTemplate="{StaticResource AdapterOption}" MaxHeight="250" SelectionChanged="OnAdapterChanged" />
            <Border x:Name="HintBar" CornerRadius="6" Padding="12,9" Margin="0,4,0,0" Background="{DynamicResource State.WarnBg}"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="14" Margin="0,0,10,0"
                               Foreground="{DynamicResource State.Warn}" VerticalAlignment="Top" />
                    <TextBlock x:Name="HintText" FontSize="13" TextWrapping="Wrap" MaxWidth="480" />
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Дополнительно -->
            <TextBlock Text="{l:Tr Advanced}" Style="{StaticResource Text.Section}" Margin="2,24,0,8" />
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <Grid x:Name="KillSwitchRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{l:Tr KillSwitchTitle}" FontSize="14" />
                            <TextBlock Text="{l:Tr KillSwitchDesc}"
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="KillSwitch" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                    </Grid>
                    <Border x:Name="KillSwitchDivider" Height="1" Background="{DynamicResource Divider}" Margin="-16,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{l:Tr RuleEnabled}" FontSize="14" />
                            <TextBlock Text="{l:Tr RuleEnabledDesc}"
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="EnabledToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="{DynamicResource Dialog.FooterBg}" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Divider}" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveButton" Content="{l:Tr Save}" Style="{StaticResource Btn.Accent}" IsDefault="True" Click="OnSave" />
                <Button Grid.Column="2" Content="{l:Tr Cancel}" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
