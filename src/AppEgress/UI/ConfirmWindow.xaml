<Window x:Class="AppEgress.UI.ConfirmWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AppEgress.Localization"
        Title="AppEgress"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.Text}" FontSize="14"
        Foreground="{DynamicResource Text.Primary}"
        UseLayoutRounding="True">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="TitleBar" Height="32" />
        <StackPanel Grid.Row="1" Margin="24,0,24,24">
            <TextBlock x:Name="Heading" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" />
            <TextBlock x:Name="Message" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
        </StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource Dialog.FooterBg}" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Divider}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PrimaryButton" Style="{StaticResource Btn.Accent}" IsDefault="True" Click="OnPrimary" />
                <Button x:Name="CloseButton" Grid.Column="2" Content="{l:Tr Cancel}" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
